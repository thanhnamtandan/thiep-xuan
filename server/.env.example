# Khóa API Claude (lấy tại console.anthropic.com). Bỏ trống thì máy chủ dùng thư viện lời chúc soạn sẵn.
ANTHROPIC_API_KEY=
PORT=8787
# Số lượt AI miễn phí mỗi thiết bị mỗi ngày
FREE_AI_PER_DAY=5
# Model và mức effort (mặc định claude-opus-5-5, low)
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# Tên miền web được gọi API; để * khi đang thử nghiệm
CORS_ORIGIN=*
